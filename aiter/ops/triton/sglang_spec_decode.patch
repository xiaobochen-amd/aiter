+def _fused_draft_sample():
+    """aiter's fused softmax + Gumbel-max draw, or None if unavailable.
+
+    The torch chain below is seven full-vocab passes whose kernels run one
+    program per row -- 8-14 programs on a 256-CU part. aiter.draft_sample does
+    the same work in two column-split passes. Resolved once, before graph
+    capture; AITER_FUSED_DRAFT_SAMPLE=0 restores the torch chain.
+    """
+    global _FUSED_DRAFT_SAMPLE
+    if _FUSED_DRAFT_SAMPLE is None:
+        _FUSED_DRAFT_SAMPLE = False
+        if os.environ.get("AITER_FUSED_DRAFT_SAMPLE", "1") == "1":
+            try:
+                from aiter.ops.triton.draft_sample import draft_sample
+
+                _FUSED_DRAFT_SAMPLE = draft_sample
+            except Exception:
+                logger.warning_once("aiter fused draft sampling unavailable")
+    return _FUSED_DRAFT_SAMPLE
+
