+def fused_verify_probs():
+    """aiter's fused verify softmax, or None if unavailable.
+
+    The torch form is three full-vocab kernels (repeat_interleave of the
+    temperatures, a divide, and a one-program-per-row softmax) on
+    [bs * num_draft_tokens, vocab]; the aiter op is two column-split passes.
+    Resolved once; AITER_FUSED_VERIFY_PROBS=0 restores the torch chain.
+    """
+    global _FUSED_VERIFY_PROBS
+    if _FUSED_VERIFY_PROBS is None:
+        _FUSED_VERIFY_PROBS = False
+        if os.environ.get("AITER_FUSED_VERIFY_PROBS", "1") == "1":
+            try:
+                from aiter.ops.triton.draft_sample import verify_target_probs
+
+                _FUSED_VERIFY_PROBS = verify_target_probs
+            except Exception:
+                logger.warning_once("aiter fused verify probs unavailable")
+    return _FUSED_VERIFY_PROBS
+
+
+_VOCAB_PARALLEL_ARGMAX = None
+
+
+def _vocab_parallel_argmax():
+    """aiter's sharded greedy argmax pair, or None if unavailable."""
+    global _VOCAB_PARALLEL_ARGMAX
+    if _VOCAB_PARALLEL_ARGMAX is None:
+        _VOCAB_PARALLEL_ARGMAX = False
+        try:
+            from aiter.ops.triton.draft_sample import (
+                shard_argmax_partials,
+                shard_argmax_reduce,
+            )
+
+            _VOCAB_PARALLEL_ARGMAX = (shard_argmax_partials, shard_argmax_reduce)
+        except Exception:
+            logger.warning_once("aiter vocab-parallel greedy argmax unavailable")
+    return _VOCAB_PARALLEL_ARGMAX
+
+
+def vocab_parallel_argmax_available() -> bool:
+    """True when aiter can reduce shard partials into a global argmax.
+
+    The caller has to ask before it disables a logits processor all-gather: with
+    the gather gone and the reduce missing, a greedy pick would argmax this
+    rank's slice and hand back a shard-local id.
+    """
+    return bool(_vocab_parallel_argmax())
+
+
+def greedy_draft_pick(logits, vocab_size, tp_group):
+    """Greedy next draft token from a (possibly vocab-sharded) logits row.
+
+    When the draft's logits processor skipped its all-gather, ``logits`` is only
+    this rank's lm_head shard; the ranks then exchange the per-chunk (max, id)
+    partials -- twelve bytes per (row, chunk) -- instead of two bytes per vocab
+    entry per row. Ties resolve to the lowest id, which is what the gathered
+    row's argmax would return and what ROCm's torch.argmax does not guarantee
+    (sglang #26358).
+    """
+    fns = _vocab_parallel_argmax()
+    if not fns:
+        return torch.argmax(logits, dim=-1, keepdim=True)
+    partials_fn, reduce_fn = fns
+    rows, width = logits.shape
+    tp_size = tp_group.world_size if tp_group is not None else 1
+    sharded = width < vocab_size
+    offset = tp_group.rank_in_group * width if sharded else 0
+    parts, nsplit = partials_fn(logits, offset, vocab_size)
+    if sharded:
+        _log_fused_once(
+            "greedy_draft_pick shard=%d/%d gather=%dB (full row would be %dB)"
+            % (width, vocab_size, parts.numel() * 4 * tp_size, rows * vocab_size * 2),
+            logits.shape,
+        )
+        parts = tp_group.all_gather(parts, dim=0)
+    else:
+        tp_size = 1
+        _log_fused_once("greedy_draft_pick full-row", logits.shape)
+    return reduce_fn(parts, rows, nsplit, tp_size)
+
+
+_FUSED_SEEN = set()
+
+
+def _log_fused_once(tag, shape):
+    """One line per server proving the fused branch was actually entered."""
+    if tag not in _FUSED_SEEN:
+        _FUSED_SEEN.add(tag)
+        logger.info("aiter fused %s active, first shape %s", tag, tuple(shape))
+
